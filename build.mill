package build
import mill.*, scalalib.*

/* kalandra, a deployment of grit that keeps grit's own projects: a Scala module against grit's
 * kit, the projects plugin, the commands edge and Claude Code's adapter, as grit publishes them
 * to the local ivy repository (which Mill resolves from by default). Its one edge, grit's commands
 * edge, serves the plugin's commands over localhost HTTP. Scala and the JDK are grit's. */
object `package` extends ScalaModule {
  def scalaVersion = "3.9.0"

  /* grit's flags, so kalandra is held to grit's conventions: braces only (-no-indent), capture
   * and separation checking, and every warning an error (-Werror). Under lint
   * (KALANDRA_LINT=1), -Wunused:all too. */
  def scalacOptions = Task {
    Seq(
      "-no-indent",
      "-language:experimental.captureChecking",
      "-language:experimental.separationChecking",
      "-deprecation",
      "-feature",
      "-Werror"
    ) ++ Option.when(lint())("-Wunused:all")
  }

  /* Whether this is the unused-warnings pass: `KALANDRA_LINT=1 MILL_OUTPUT_DIR=out/lint ./mill
   * __.compile`. An input, so every run reads the shell's value afresh. */
  def lint = Task.Input { Task.env.get("KALANDRA_LINT").contains("1") }

  /* grit's version. A release (`0.3.0`) is tagged in grit and never republished under its tag,
   * so it names one build of grit. A snapshot (`0.3.0-SNAPSHOT`) is republished in place from
   * grit's `main`, under the marker scripts/publish-local writes beside the modules
   * (`~/.ivy2/local/dev.grit/.publish-local-<version>`, holding the commit), so while the pin is
   * one, `bin/kalandra build` cleans the resolution first and refuses a marker that moved. */
  def gritVersion = "0.3.0-SNAPSHOT"

  /* Which grit the jar is built against: the version, and for a snapshot ` at <commit>` from its
   * marker. An input, so a republish is seen; carried in the jar as `kalandra/grit.txt`, and
   * serve's log says it. */
  def gritBuilt = Task.Input {
    val marker = os.home / ".ivy2" / "local" / "dev.grit" / s".publish-local-$gritVersion"
    if (os.exists(marker)) s"$gritVersion at ${os.read(marker).trim}" else gritVersion
  }

  def gritResource = Task {
    os.write(Task.dest / "kalandra" / "grit.txt", gritBuilt(), createFolders = true)
    PathRef(Task.dest)
  }

  def resources = Task { super.resources() :+ gritResource() }

  def mvnDeps = Seq(
    mvn"dev.grit::grit-kit:${gritVersion}",
    mvn"dev.grit::grit-chat:${gritVersion}",
    mvn"dev.grit::grit-projects:${gritVersion}",
    mvn"dev.grit::grit-commands:${gritVersion}",
    mvn"dev.grit::grit-claudecode:${gritVersion}"
  )

  def forkArgs = Seq("--sun-misc-unsafe-memory-access=allow")

  def javaHome = Task {
    sys.env
      .get("GRIT_JDK_HOME")
      .orElse(Some("/home/nickchilders/.jdks/jdk-26.0.2"))
      .filter(p => os.exists(os.Path(p)))
      .map(p => PathRef(os.Path(p)))
  }

  def mainClass = Some("kalandra.main.Main")

  /* kalandra's tests: utest, as grit's. Scala 3.9's -Wunused reports a pattern variable read
   * only inside utest's `assert` macro as unused; silenced in tests, as grit does. */
  object test extends ScalaTests with TestModule.Utest {
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.9.5")
    def forkArgs = Seq("--sun-misc-unsafe-memory-access=allow")
    def scalacOptions = Task {
      super.scalacOptions() ++
        Option.when(build.lint())("-Wconf:msg=unused pattern variable:s")
    }
  }
}
