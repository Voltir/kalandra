[Unit]
Description=Dump grit_kalandra and prune old dumps (kalandra's ops/backup.sh)
After=docker.service

[Service]
Type=oneshot
# KALANDRA_BACKUP_DIR and GRIT_COMPOSE_DIR may be set here; the script's defaults are
# $HOME/backups/grit_kalandra and $HOME/Projects/grit.
ExecStart=%h/Projects/kalandra/ops/backup.sh
