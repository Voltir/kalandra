#!/usr/bin/env bash
# workshop's command line.
#
#   bin/workshop serve                      serve the deployment (blocks; stop it with SIGTERM)
#   bin/workshop export <project> <dir>     write a project's export files under <dir>
#   bin/workshop import <grit> [--dry-run]  import grit's planning tree into the project `grit`
#   bin/workshop verify <grit>              check the project `grit` holds that tree whole
#   bin/workshop <command> [json]           run a projects command through a running serve:
#                                           `keep` or `project_keep`, its arguments a JSON object
#   bin/workshop build                      build the jar serve and export run from
#   bin/workshop slot [agent-type]          the slot a claim's `for` names here (hooks/brief-hook.sh)
#
# A command prints the edge's answer and exits 0 only when it did what it was asked; it fails
# loud, exit 2, when serve is not reachable at WORKSHOP_LISTEN (default 127.0.0.1:7317).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
jar="$root/out/assembly.dest/out.jar"
java="${GRIT_JDK_HOME:-/home/nickchilders/.jdks/jdk-26.0.2}/bin/java"
listen="${WORKSHOP_LISTEN:-127.0.0.1:7317}"

usage() {
  sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

build() {
  (cd "$root" && ./mill show assembly >/dev/null)
}

[[ $# -ge 1 ]] || usage

case "$1" in
  build)
    build
    ;;
  slot)
    exec "$root/hooks/brief-hook.sh" --slot "${2-}"
    ;;
  serve | export | import | verify)
    [[ -f "$jar" ]] || build
    exec "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    name="$1"
    [[ "$name" == project_* ]] || name="project_$name"
    body="${2:-}"
    out="$(mktemp)"
    trap 'rm -f "$out"' EXIT
    if ! status="$(curl -sS -o "$out" -w '%{http_code}' -X POST \
      -H 'Content-Type: application/json' --data-binary "$body" \
      "http://$listen/command/$name" 2>"$out.err")"; then
      echo "workshop: serve is not reachable at $listen: $(cat "$out.err")" >&2
      rm -f "$out.err"
      exit 2
    fi
    rm -f "$out.err"
    cat "$out"
    [[ -s "$out" && "$(tail -c1 "$out")" != "" ]] && echo
    if [[ "$status" != 200 ]]; then
      echo "workshop: $name answered $status" >&2
      exit 1
    fi
    ;;
esac
