#!/usr/bin/env bash
# kalandra's command line.
#
#   bin/kalandra serve                      serve the deployment (blocks; stop it with SIGTERM)
#   bin/kalandra export <project> <dir>     write a project's export files under <dir>
#   bin/kalandra import <grit> [--dry-run]  import grit's planning tree into the project `grit`
#   bin/kalandra verify <grit>              check the project `grit` holds that tree whole
#   bin/kalandra <command> [json]           run a projects command through a running serve:
#                                           `keep` or `project_keep`, its arguments a JSON object
#   bin/kalandra build                      build the jar serve and export run from
#   bin/kalandra slot [agent-type]          the slot a claim's `for` names here (hooks/brief-hook.sh)
#   bin/kalandra stop                       stop serve: SIGTERM its processes, wait up to 30 s
#   bin/kalandra start                      start serve in the background (no build), wait until it answers
#   bin/kalandra restart                    stop, then start
#   bin/kalandra status                     serve's pids, and whether commands answer
#
# A command prints the edge's answer and exits 0 only when it did what it was asked; it fails
# loud, exit 2, when serve is not reachable at KALANDRA_LISTEN (default 127.0.0.1:7317).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
jar="$root/out/assembly.dest/out.jar"
java="${GRIT_JDK_HOME:-/home/nickchilders/.jdks/jdk-26.0.2}/bin/java"
listen="${KALANDRA_LISTEN:-127.0.0.1:7317}"

usage() {
  sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

build() {
  (cd "$root" && ./mill show assembly >/dev/null)
}

# serve's pids, one a line: a java process whose cwd is this checkout, whose argv holds the exact
# argument `serve`, and whose KALANDRA_LISTEN (unset or empty: the default 127.0.0.1:7317) is this
# script's $listen, so stop never touches a serve this script does not talk to (a restore test's
# copy on another port). argv and environ are read NUL-split, so no substring of either matches,
# and the running shell (its exe is bash, not java) is never serve.
serve_pids() {
  local p pid exe arg found entry env_val
  for p in /proc/[0-9]*; do
    pid="${p#/proc/}"
    [[ "$pid" == "$$" || "$pid" == "${BASHPID-}" ]] && continue
    [[ "$(readlink "$p/cwd" 2>/dev/null)" == "$root" ]] || continue
    exe="$(readlink "$p/exe" 2>/dev/null)" || continue
    [[ "$exe" == */java ]] || continue
    found=0
    while IFS= read -r -d '' arg; do
      if [[ "$arg" == serve ]]; then found=1; fi
    done <"$p/cmdline" || continue
    [[ "$found" == 1 ]] || continue
    env_val=""
    while IFS= read -r -d '' entry; do
      if [[ "$entry" == KALANDRA_LISTEN=* ]]; then env_val="${entry#KALANDRA_LISTEN=}"; fi
    done <"$p/environ" || continue
    if [[ "${env_val:-127.0.0.1:7317}" == "$listen" ]]; then echo "$pid"; fi
  done
  return 0
}

# Whether serve answers a projects command at all: any HTTP answer, even a refusal, counts; only
# unreachable (the command's exit 2) does not.
serve_answers() {
  local rc=0
  "$root/bin/kalandra" project_list '{"project":"grit"}' >/dev/null 2>&1 || rc=$?
  [[ "$rc" != 2 ]]
}

serve_stop() {
  local ps
  ps="$(serve_pids)"
  if [[ -z "$ps" ]]; then
    echo "serve is not running."
    return 0
  fi
  kill $ps 2>/dev/null || true
  for _ in $(seq 30); do
    if [[ -z "$(serve_pids)" ]]; then
      echo "Stopped serve (pids: $(echo $ps))."
      return 0
    fi
    sleep 1
  done
  echo "serve still running after 30 s: $(echo $(serve_pids))" >&2
  return 1
}

serve_start() {
  if [[ -n "$(serve_pids)" ]]; then
    echo "serve is already running: $(echo $(serve_pids))" >&2
    return 1
  fi
  export GRIT_DATABASE_URL="${GRIT_DATABASE_URL:-jdbc:postgresql://localhost:5432/grit_kalandra}"
  cd "$root"
  mkdir -p logs
  ( setsid nohup "$root/bin/kalandra" serve >> logs/serve.log 2>&1 < /dev/null & )
  for _ in $(seq 60); do
    if serve_answers; then
      local first
      first="$(serve_pids | head -n 1)"
      echo "serve started (pid ${first:-?})"
      return 0
    fi
    sleep 2
  done
  echo "serve did not answer within 120 s; see $root/logs/serve.log" >&2
  return 1
}

serve_status() {
  local ps
  ps="$(serve_pids)"
  if [[ -z "$ps" ]]; then
    echo "serve pids: none"
  else
    echo "serve pids: $(echo $ps)"
  fi
  if serve_answers; then
    echo "commands answer at $listen"
  else
    echo "commands do not answer at $listen"
  fi
}

[[ $# -ge 1 ]] || usage

case "$1" in
  build)
    build
    ;;
  slot)
    exec "$root/hooks/brief-hook.sh" --slot "${2-}"
    ;;
  stop)
    serve_stop
    ;;
  start)
    serve_start
    ;;
  restart)
    serve_stop && serve_start
    ;;
  status)
    serve_status
    ;;
  serve | export | import | verify)
    [[ -f "$jar" ]] || build
    exec "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    name="$1"
    [[ "$name" == project_* ]] || name="project_$name"
    body="${2:-}"
    out="$(mktemp)"
    trap 'rm -f "$out"' EXIT
    if ! status="$(curl -sS -o "$out" -w '%{http_code}' -X POST \
      -H 'Content-Type: application/json' --data-binary "$body" \
      "http://$listen/command/$name" 2>"$out.err")"; then
      echo "kalandra: serve is not reachable at $listen: $(cat "$out.err")" >&2
      rm -f "$out.err"
      exit 2
    fi
    rm -f "$out.err"
    cat "$out"
    [[ -s "$out" && "$(tail -c1 "$out")" != "" ]] && echo
    if [[ "$status" != 200 ]]; then
      echo "kalandra: $name answered $status" >&2
      exit 1
    fi
    ;;
esac
