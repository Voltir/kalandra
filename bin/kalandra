#!/usr/bin/env bash
# kalandra's command line.
#
#   bin/kalandra serve                      serve the deployment (blocks; stop it with SIGTERM)
#   bin/kalandra chat                       the chat on this terminal, in the grit checkout's room
#   bin/kalandra cache-report [id]          a conversation's cache use per model call (the chat's)
#   bin/kalandra work [--dry] PROPOSE.md    a proposal, run in an evidence checkout `scripts/eval
#                                           propose` wrote: serve stopped, the proposer's turns
#                                           run, serve started again however it ends; --dry shows
#                                           its first model call instead, and reads no key
#   bin/kalandra amendments <dir>           every amendment of the project grit, ended ones
#                                           included, as exported, a file each under <dir>
#   bin/kalandra export <project> <dir>     write a project's export files under <dir>
#   bin/kalandra import <grit> [--dry-run]  import grit's planning tree into the project `grit`
#   bin/kalandra verify <grit>              check the project `grit` holds that tree whole
#   bin/kalandra <command> [json]           run a projects command through a running serve:
#                                           `keep` or `project_keep`, its arguments a JSON object
#   bin/kalandra standing '{"key":"<key>"}'  a standing section's text, or an amendment's candidate's,
#                                           as a bench's --standing file holds it; keeps nothing;
#                                           for a section, its version on stderr (propose --against)
#   bin/kalandra adopt '{"key":"<key>"}'     keep an amendment's candidate as its section's next
#                                           version, under the section's cap, and adopt it
#   bin/kalandra build                      build the jar serve and export run from
#   bin/kalandra holder ['<json>']          the claim holder a session in a directory works as, for a
#                                           claim's `holder`: {"dir"} (default $PWD), and for an agent
#                                           the session starts {"type","session"} (session default
#                                           $CLAUDE_CODE_SESSION_ID; exit 2 without one)
#   bin/kalandra wait '<json>'              wait until an artifact reaches a state, or a commit is made
#                                           ({"artifact":"<key>","state":["review"]},
#                                           {"commit":{"holder":"<holder>"}} or
#                                           {"commit":{"worktree":"<path>"}}; "within" seconds,
#                                           default 300, at most 600): exit 0 met, 3 lapsed
#   bin/kalandra stop                       stop serve: SIGTERM its processes, wait up to 30 s
#   bin/kalandra start                      start serve in the background (no build), wait until it answers
#   bin/kalandra restart                    stop, then start
#   bin/kalandra status                     serve's pids, and whether commands answer
#   bin/kalandra deploy <proof-dir>         deploy a proven build, or roll back: ops/deploy.sh
#
# A command prints the edge's answer and exits 0 only when it did what it was asked; it fails
# loud, exit 2, when serve is not reachable at KALANDRA_LISTEN (default 127.0.0.1:7317).
#
# Every request to serve bears a credential, read from a file and sent as `Authorization: Bearer`
# without ever being on a command line or in an environment: inside a Claude Code session
# (CLAUDE_CODE_SESSION_ID set) the sessions' credential, ~/.config/grit/credential, whatever
# KALANDRA_CREDENTIAL says; otherwise the file KALANDRA_CREDENTIAL names, or
# ~/.config/kalandra/credential, the command line's. A missing or empty file exits 78, sending
# nothing; a credential serve refuses (401) exits 1, naming the file.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
jar="$root/out/assembly.dest/out.jar"
java="${GRIT_JDK_HOME:-/home/nickchilders/.jdks/jdk-26.0.2}/bin/java"
listen="${KALANDRA_LISTEN:-127.0.0.1:7317}"

# The sessions' credential, which the join also writes into the hook.
sessions_credential="$HOME/.config/grit/credential"

# The file of the credential this run sends, as the header says.
credential_file() {
  if [[ -n "${CLAUDE_CODE_SESSION_ID-}" ]]; then
    printf '%s\n' "$sessions_credential"
  elif [[ -n "${KALANDRA_CREDENTIAL-}" ]]; then
    printf '%s\n' "$KALANDRA_CREDENTIAL"
  else
    printf '%s\n' "$HOME/.config/kalandra/credential"
  fi
}

# Sets `cred` to the chosen file, or exits 78 saying so when it is missing, unreadable or empty.
need_credential() {
  cred="$(credential_file)"
  if ! [[ -f "$cred" && -r "$cred" ]] || ! grep -q '[^[:space:]]' "$cred" 2>/dev/null; then
    echo "kalandra: cannot read a credential in $cred; nothing was sent: ask whoever runs serve for this credential and put it in $cred" >&2
    exit 78
  fi
}

# curl to serve, bearing the credential in $cred: never on argv, nor in any environment
# (printf and $(<…) are bash's own).
serve_curl() {
  curl -q --noproxy '*' -H @<(printf 'Authorization: Bearer %s\n' "$(<"$cred")") "$@"
}

# What a 401 for `$1` says, after the edge's own line.
refused_credential() {
  echo "kalandra: serve at $listen refused the credential in $cred (401) for $1; ask whoever runs serve for this credential and put it in $cred" >&2
}

usage() {
  sed -n '2,/^[^#]/{/^#/p}' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

# The deployment's keys (Anthropic's, Jev's), for the commands that run turns alone. A missing
# file or key is refused by the jar, saying so.
load_keys() {
  if [[ -f "$root/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    . "$root/.env"
    set +a
  fi
}

# The jar. While build.mill pins a snapshot, which grit republishes in place, the resolution is
# cleaned first and the snapshot's marker read before and after: a marker that moved, or a
# publish under way (a .publish-local.* directory), is refused, as the jar could mix two of them.
build() {
  local version marker before after
  version="$(sed -n 's/^ *def gritVersion = "\(.*\)"$/\1/p' "$root/build.mill")"
  if [[ "$version" != *-SNAPSHOT ]]; then
    (cd "$root" && ./mill show assembly >/dev/null)
    return
  fi
  marker="$HOME/.ivy2/local/dev.grit/.publish-local-$version"
  snapshot_steady() {
    if compgen -G "$HOME/.ivy2/local/.publish-local.*" >/dev/null ||
      compgen -G "$HOME/.ivy2/local/dev.grit/.publish-local.*" >/dev/null; then
      echo "kalandra: grit $version is being published (a .publish-local.* directory); build again after" >&2
      return 1
    fi
  }
  snapshot_steady || return 1
  before="$(cat "$marker" 2>/dev/null)" || { echo "kalandra: grit $version has no marker at $marker; publish it first" >&2; return 1; }
  (cd "$root" && ./mill clean __.resolvedMvnDeps __.resolvedRunMvnDeps >/dev/null && ./mill show assembly >/dev/null)
  after="$(cat "$marker" 2>/dev/null || true)"
  snapshot_steady || return 1
  if [[ "$after" != "$before" ]]; then
    echo "kalandra: grit $version was republished during the build ($before, now ${after:-none}); build again" >&2
    return 1
  fi
  echo "built against grit $version at $before"
}

# serve's pids, one a line: a java process whose cwd is this checkout, whose argv holds the exact
# argument `serve`, and whose KALANDRA_LISTEN (unset or empty: the default 127.0.0.1:7317) is this
# script's $listen, so stop never touches a serve this script does not talk to (a restore test's
# copy on another port). argv and environ are read NUL-split, so no substring of either matches,
# and the running shell (its exe is bash, not java) is never serve.
serve_pids() {
  local p pid exe arg found entry env_val
  for p in /proc/[0-9]*; do
    pid="${p#/proc/}"
    [[ "$pid" == "$$" || "$pid" == "${BASHPID-}" ]] && continue
    [[ "$(readlink "$p/cwd" 2>/dev/null)" == "$root" ]] || continue
    exe="$(readlink "$p/exe" 2>/dev/null)" || continue
    [[ "$exe" == */java ]] || continue
    found=0
    while IFS= read -r -d '' arg; do
      if [[ "$arg" == serve ]]; then found=1; fi
    done <"$p/cmdline" || continue
    [[ "$found" == 1 ]] || continue
    env_val=""
    while IFS= read -r -d '' entry; do
      if [[ "$entry" == KALANDRA_LISTEN=* ]]; then env_val="${entry#KALANDRA_LISTEN=}"; fi
    done <"$p/environ" || continue
    if [[ "${env_val:-127.0.0.1:7317}" == "$listen" ]]; then echo "$pid"; fi
  done
  return 0
}

# Whether serve answers at all: asked with no credential, any HTTP answer counts, the 401 a
# credentialed edge gives it included; only no answer does not.
serve_answers() {
  curl -q -s --noproxy '*' --max-time "${1:-5}" -o /dev/null -X POST -d '{}' \
    "http://$listen/command/project_list" 2>/dev/null
}

# Whether serve answers within 120 s of wall clock, asked every 2 s.
answers_within_120() {
  local deadline=$((SECONDS + 120))
  while ((SECONDS < deadline)); do
    serve_answers 2 && return 0
    ((SECONDS + 2 < deadline)) || break
    sleep 2
  done
  return 1
}

serve_stop() {
  local ps
  ps="$(serve_pids)"
  if [[ -z "$ps" ]]; then
    echo "serve is not running."
    return 0
  fi
  kill $ps 2>/dev/null || true
  for _ in $(seq 30); do
    if [[ -z "$(serve_pids)" ]]; then
      echo "Stopped serve (pids: $(echo $ps))."
      return 0
    fi
    sleep 1
  done
  echo "serve still running after 30 s: $(echo $(serve_pids))" >&2
  return 1
}

serve_start() {
  if [[ -n "$(serve_pids)" ]]; then
    echo "serve is already running: $(echo $(serve_pids))" >&2
    return 1
  fi
  export GRIT_DATABASE_URL="${GRIT_DATABASE_URL:-jdbc:postgresql://localhost:5432/grit_kalandra}"
  cd "$root"
  mkdir -p logs
  ( setsid nohup "$root/bin/kalandra" serve >> logs/serve.log 2>&1 < /dev/null & )
  if answers_within_120; then
    local first
    first="$(serve_pids | head -n 1)"
    echo "serve started (pid ${first:-?})"
    return 0
  fi
  echo "serve did not answer within 120 s; see $root/logs/serve.log" >&2
  return 1
}

# Whether the systemd user unit (ops/systemd/kalandra-serve.service) owns serve: then start, stop
# and restart go through it, so a serve started by hand never races the unit for the port.
unit=kalandra-serve.service
managed() {
  [[ "$listen" == 127.0.0.1:7317 ]] && systemctl --user is-enabled --quiet "$unit" 2>/dev/null
}

# serve's unit told to `$1`, then, but for a stop, waited on until commands answer.
unit_do() {
  systemctl --user "$1" "$unit" || return 1
  [[ "$1" == stop ]] && { echo "Stopped serve ($unit)."; return 0; }
  if answers_within_120; then
    echo "serve ${1}ed by $unit (pid $(serve_pids | head -n 1))"
    return 0
  fi
  echo "serve did not answer within 120 s; see journalctl --user -u $unit and $root/logs/serve.log" >&2
  return 1
}

# serve up again after a proposal stopped it: a serve that is up already, which the systemd unit
# may have started meanwhile, is left as it is.
serve_again() {
  if managed; then
    unit_do start
  elif [[ -n "$(serve_pids)" ]]; then
    echo "serve is up already: $(echo $(serve_pids))"
  else
    serve_start
  fi
}

serve_status() {
  local ps
  if managed; then echo "managed by $unit: $(systemctl --user is-active "$unit")"; fi
  ps="$(serve_pids)"
  if [[ -z "$ps" ]]; then
    echo "serve pids: none"
  else
    echo "serve pids: $(echo $ps)"
  fi
  if serve_answers; then
    echo "commands answer at $listen"
  else
    echo "commands do not answer at $listen"
  fi
}

[[ $# -ge 1 ]] || usage

case "$1" in
  build)
    build
    ;;
  slot)
    echo "kalandra: slot is gone; a claim's holder is what bin/kalandra holder prints" >&2
    exit 64
    ;;
  holder)
    args="${2:-}"
    [[ -n "$args" ]] || args='{}'
    if ! query="$(jq -er --arg pwd "$PWD" --arg sid "${CLAUDE_CODE_SESSION_ID-}" '
      if type != "object" then error("the holder'"'"'s arguments are a JSON object")
      elif (keys - ["dir", "type", "session"]) != [] then
        error("holder reads dir, type and session alone")
      else
        [ ["harness", "claude-code"], ["dir", (.dir // $pwd)] ]
        + (if .type then [["type", .type], ["session", (.session // $sid)]] else [] end)
        | map(select(.[1] != "")) | map("\(.[0])=\(.[1] | @uri)") | join("&")
      end' <<<"$args" 2>&1)"; then
      echo "kalandra: ${query#jq: error (at <stdin>:*): }" >&2
      exit 64
    fi
    if jq -e 'has("type")' <<<"$args" >/dev/null && [[ "$query" != *"&session="* ]]; then
      echo "kalandra: an agent's holder needs its session's id: CLAUDE_CODE_SESSION_ID is not set" >&2
      exit 2
    fi
    need_credential
    out="$(mktemp)"
    trap 'rm -f "$out" "$out.err"' EXIT
    if ! status="$(serve_curl -sS -o "$out" -w '%{http_code}' "http://$listen/holder?$query" 2>"$out.err")"; then
      echo "kalandra: serve is not reachable at $listen: $(cat "$out.err")" >&2
      exit 2
    fi
    cat "$out"
    [[ -s "$out" && "$(tail -c1 "$out")" != "" ]] && echo
    if [[ "$status" == 401 ]]; then
      refused_credential holder
      exit 1
    elif [[ "$status" != 200 ]]; then
      echo "kalandra: holder answered $status" >&2
      exit 1
    fi
    ;;
  stop)
    if managed; then unit_do stop; else serve_stop; fi
    ;;
  start)
    if managed; then unit_do start; else serve_start; fi
    ;;
  restart)
    if managed; then unit_do restart; else serve_stop && serve_start; fi
    ;;
  status)
    serve_status
    ;;
  deploy)
    exec bash "$root/ops/deploy.sh" "${@:2}"
    ;;
  serve)
    load_keys
    [[ -f "$jar" ]] || build
    exec "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  chat)
    load_keys
    export KALANDRA_LOGS="$root/logs"
    mkdir -p "$KALANDRA_LOGS"
    [[ -f "$jar" ]] || build
    # The terminal library calls native code.
    exec "$java" --sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED \
      -jar "$jar" "$@"
    ;;
  cache-report)
    # Jev's key too: the deployment is refused without it, though the report calls no model.
    load_keys
    export KALANDRA_LOGS="$root/logs"
    mkdir -p "$KALANDRA_LOGS"
    [[ -f "$jar" ]] || build
    exec "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  work)
    [[ -f "$jar" ]] || build
    dry=0
    for a in "${@:2}"; do [[ "$a" == --dry ]] && dry=1; done
    export KALANDRA_LOGS="$root/logs"
    mkdir -p "$KALANDRA_LOGS"
    export GRIT_DATABASE_URL="${GRIT_DATABASE_URL:-jdbc:postgresql://localhost:5432/grit_kalandra}"
    # No key read for a dry run: it is refused with one. Run here, in the evidence checkout.
    [[ "$dry" == 1 ]] || load_keys
    # The proposer runs on an engine of its own, dry or not, so that a dry run shows the tools a
    # real one is offered: serve stops for the run and starts again after it, however it ends.
    if managed; then unit_do stop; else serve_stop; fi
    trap 'serve_again' EXIT
    "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  amendments)
    [[ $# -eq 2 ]] || usage
    need_credential
    export KALANDRA_CREDENTIAL="$cred"
    [[ -f "$jar" ]] || build
    exec "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  export | import | verify)
    need_credential
    export KALANDRA_CREDENTIAL="$cred"
    [[ -f "$jar" ]] || build
    exec "$java" --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  wait)
    need_credential
    out="$(mktemp)"
    trap 'rm -f "$out" "$out.err"' EXIT
    # The edge holds a watch at most 10 minutes; a little more lets its answer arrive.
    if ! status="$(serve_curl -sS --max-time 630 -o "$out" -w '%{http_code}' -X POST \
      -H 'Content-Type: application/json' --data-binary "${2:-}" \
      "http://$listen/wait" 2>"$out.err")"; then
      echo "kalandra: serve is not reachable at $listen: $(cat "$out.err")" >&2
      exit 2
    fi
    cat "$out"
    [[ -s "$out" && "$(tail -c1 "$out")" != "" ]] && echo
    case "$status" in
      200) exit 0 ;;
      408) exit 3 ;;
      401)
        refused_credential wait
        exit 1
        ;;
      *)
        echo "kalandra: wait answered $status" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    name="$1"
    [[ "$name" == project_* ]] || name="project_$name"
    body="${2:-}"
    need_credential
    out="$(mktemp)"
    trap 'rm -f "$out"' EXIT
    if ! status="$(serve_curl -sS -o "$out" -w '%{http_code}' -X POST \
      -H 'Content-Type: application/json' --data-binary "$body" \
      "http://$listen/command/$name" 2>"$out.err")"; then
      echo "kalandra: serve is not reachable at $listen: $(cat "$out.err")" >&2
      rm -f "$out.err"
      exit 2
    fi
    rm -f "$out.err"
    cat "$out"
    [[ -s "$out" && "$(tail -c1 "$out")" != "" ]] && echo
    if [[ "$status" == 401 ]]; then
      refused_credential "$name"
      exit 1
    elif [[ "$status" != 200 ]]; then
      echo "kalandra: $name answered $status" >&2
      exit 1
    fi
    # A section's version, for scripts/eval propose --against, on stderr so the text stays the
    # file a bench reads. An amendment's candidate is no version of its section, so none is said.
    if [[ "$name" == project_standing ]]; then
      shown="$(serve_curl -sS -X POST -H 'Content-Type: application/json' --data-binary "$body" \
        "http://$listen/command/project_show" 2>/dev/null || true)"
      if grep -qx 'kind: section' <<<"$shown"; then
        echo "$(grep -m1 '^key: ' <<<"$shown" | cut -c6-) at version $(grep -m1 '^version: ' <<<"$shown" | cut -c10-)" >&2
      fi
    fi
    ;;
esac
